////GLOBAL
#version 400

// license:GPLv3+

////DEFINES
#include "Helpers.fxh"

////VERTEX
layout(location=0) in vec3 vPosition;
layout(location=1) in vec3 vNormal;
layout(location=2) in float2 tc;
out float2 tex0;
out float4 color0;
out float2 clipPos;

uniform mat4 matWorldView[N_EYES];

////FRAGMENT
uniform sampler2D tex_base_color;

in float2 tex0;
in float4 color0;
in float2 clipPos;

out vec4 color;
#ifdef SHADER_GL410
flat in int glLayer_gs;
#endif

uniform float4 clip_plane;

uniform float4 staticColor_Alpha;
#define isSRGBTexture (staticColor_Alpha.y != 0.0) // Sampling decodes sRGB to linear (table images)

////vs_liveui_main
void main()
{
   clipPos = vPosition.xy;
   gl_Position = matWorldView[0] * vec4(vPosition.x, vPosition.y, 0.0, 1.0);
   color0 = float4(vNormal.rgb, vPosition.z); // No WCG (HDR) backbuffer on OpenGL, so no SDR white level conversion (see fs_imgui.sc)
   tex0 = tc;
   //tex0 = float2(tc.x, 1.0-tc.y);
}


////ps_liveui_main
void main()
{
   if (clipPos.x < clip_plane.x || clipPos.y < clip_plane.y || clipPos.x > clip_plane.z || clipPos.y > clip_plane.w)
      discard;
   color = texture(tex_base_color, tex0);
   // ImGui works in sRGB: re-encode what the sampler decoded
   BRANCH if (isSRGBTexture)
      color.rgb = FBGamma(color.rgb);
   color *= color0;
}


////TECHNIQUES

LiveUI:P0:vs_liveui_main():ps_liveui_main()
