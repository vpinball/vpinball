<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged into the application manifest: the process code page (CP_ACP, narrow Win32 and C runtime APIs) is UTF-8,
     like all text in memory. Only applied on Windows 10 1903 and later, earlier versions keep the legacy ANSI code page. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
