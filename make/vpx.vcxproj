<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{11B81620-ADF1-46FB-98B0-AF83AB34CAAC}</ProjectGuid>
    <ProjectName>vpx</ProjectName>
    <RootNamespace>vpx</RootNamespace>
    <Keyword>AtlProj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <ImportGroup Label="Shared">
    <Import Project="vpx-core.vcxitems" Label="Shared" />
  </ImportGroup>
  <PropertyGroup>
    <TargetExt>.exe</TargetExt>
    <PreBuildEventUseInBuild>false</PreBuildEventUseInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration.SubString(0,5))' == 'Relea'" Label="Configuration">
    <GenerateManifest>true</GenerateManifest>
    <EmbedManifest>true</EmbedManifest>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <TargetName>VPinballX</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug_GL|Win32'">
    <TargetName>VPinballX_GL</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug_BGFX|Win32'">
    <TargetName>VPinballX_BGFX</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetName>VPinballX64</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug_GL|x64'">
    <TargetName>VPinballX_GL64</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug_BGFX|x64'">
    <TargetName>VPinballX_BGFX64</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <TargetName>VPinballX</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_GL|Win32'">
    <TargetName>VPinballX_GL</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_BGFX|Win32'">
    <TargetName>VPinballX_BGFX</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>VPinballX64</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_GL|x64'">
    <TargetName>VPinballX_GL64</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_BGFX|x64'">
    <TargetName>VPinballX_BGFX64</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Manifest>
      <!-- UTF-8 process code page (see the manifest file) -->
      <AdditionalManifestFiles>$(MSBuildThisFileDirectory)..\..\src\ui\win\res\utf8.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
    <PostBuildEvent>
      <Command>%40echo off
        rem FFmpeg runtime libraries, lazily loaded by the core media decoding module
        if "$(Platform)"=="x64" (
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\avcodec64-*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\avformat64-*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\avutil64-*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\swresample64-*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\swscale64-*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\libiconv-2.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\libbz2-1.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\liblzma-5.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\libwinpthread-1.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\libgcc_s_seh-1.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x64\libz-1.dll" "$(TargetDir)"
        ) else (
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\avcodec*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\avformat*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\avutil*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\swresample*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\swscale*.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\libiconv-2.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\libbz2-1.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\liblzma-5.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\libwinpthread-1.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\libgcc_s_dw2-1.dll" "$(TargetDir)"
          xcopy /y /d /q "$(SolutionDir)..\..\third-party\runtime-libs\windows-x86\libz-1.dll" "$(TargetDir)"
        )
        if ".%25VPIN_DIR%25" == "." (
          echo Define VPIN_DIR env. variable if you want to deploy on build
        ) else (
          echo Copies EXE and DLLs to production directory.
          echo VPIN_DIR="%25VPIN_DIR%25"
          if not exist "%25VPIN_DIR%25" mkdir "%25VPIN_DIR%25"
          copy "$(TargetPath)" "%25VPIN_DIR%25"
        )
      </Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <Import Project="vpx-plugins.props" />
  <ItemGroup>
    <ClCompile Include="$(SolutionDir)/../../src/core/main.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>